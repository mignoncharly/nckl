# ---- Secrets / environment ----
.env
.env.*
!.env.example

# Deployment secrets & generated configs (real values live on the server only).
# Keep the *.example templates tracked.
deploy/.secrets.json
deploy/redis-saha.conf
deploy/redis-nckl.conf
!deploy/.secrets.example.json
!deploy/redis-saha.conf.example
!deploy/redis-nckl.conf.example

# ---- Runtime / data artifacts (must never be committed) ----
deploy/redis-data/
*.rdb
*.pid
backups/
*.sql
*.dump
*.backup
*.bak

# Source-client input material: keep local unless explicitly approved.
docs/nckl_*.jpeg

# ---- Python / Django backend ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
env/
*.sqlite3
backend/staticfiles/
backend/logs/
backend/media/
backend/test_media/

# ---- Node / Next.js frontend ----
node_modules/
.next/
out/
next-env.d.ts
tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Logs / private documents ----
*.log
*.log.*
*.csv.private
*.xlsx.private
*.pdf.private

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

