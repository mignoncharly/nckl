[Unit]
Description=NCKL Celery Worker
After=network.target postgresql.service nckl-redis.service nckl-api.service
Wants=nckl-redis.service

[Service]
Type=simple
User=mignon
WorkingDirectory=/home/mignon/nckl/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/home/mignon/nckl/backend/.venv/bin/celery -A config worker --loglevel=INFO --concurrency=2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
