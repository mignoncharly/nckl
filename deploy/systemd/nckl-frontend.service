[Unit]
Description=NCKL Next.js Frontend
After=network.target

[Service]
Type=simple
User=mignon
WorkingDirectory=/home/mignon/nckl/frontend
Environment=NODE_ENV=production
Environment=PORT=3040
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3040
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
