# ---------------------------------------------------------------------------
# NCKL Logistics Services - environment configuration
# Copy this file to `.env` and replace placeholder values with NCKL-owned
# secrets and infrastructure values. NEVER commit the real `.env` file.
# ---------------------------------------------------------------------------

# Which settings module Django loads (config.settings.local | config.settings.production)
DJANGO_SETTINGS_MODULE=config.settings.local

# Django core
# Generate a new key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:3000

# PostgreSQL. Use a dedicated NCKL database and role; never reuse SAHA values.
POSTGRES_DB=nckl_db
POSTGRES_USER=nckl_user
POSTGRES_PASSWORD=change-me-nckl-postgres-password
DATABASE_URL=postgres://nckl_user:change-me-nckl-postgres-password@localhost:5432/nckl_db

# Redis. Use a dedicated NCKL Redis instance/db/password in production.
REDIS_URL=redis://localhost:6379/1

# CORS - comma separated list of allowed front-end origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email
# Local/dev: console backend prints emails to the server log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=NCKL Logistics Services <support@nckl.invalid>
# Production SMTP (only used by config.settings.production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Web Push (VAPID) keys. Generate NCKL-owned keys before production use.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=support@nckl.invalid

# Media files
MEDIA_URL=/media/
MEDIA_ROOT=/home/mignon/nckl/backend/media

# Data retention
DATA_RETENTION_DAYS=365
DATA_RETENTION_ANONYMIZE_CUSTOMERS=False

# NCKL public application configuration
NCKL_COMPANY_NAME=NCKL Logistics Services
NCKL_SHORT_NAME=NCKL
NCKL_SLOGAN_EN=Your Cargo. Our Commitment.
NCKL_SLOGAN_FR=Votre Cargaison. Notre Engagement.
NCKL_PRIMARY_WHATSAPP=+4915212392636
NCKL_PRIMARY_PHONE=+4915212392636
NCKL_SUPPORT_EMAIL=
NCKL_TIKTOK_HANDLE=@nckllogisticsservices
NCKL_TRANSIT_TIME_GERMANY_CAMEROON=3 - 10 days
NCKL_TRANSIT_TIME_CAMEROON_GERMANY=3 - 10 days
REQUEST_REFERENCE_PREFIX=NCKL

# Frontend (Next.js) - variables prefixed with NEXT_PUBLIC_ are exposed to browsers.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_COMPANY_NAME=NCKL Logistics Services
NEXT_PUBLIC_SHORT_NAME=NCKL
NEXT_PUBLIC_WHATSAPP_NUMBER=+4915212392636
NEXT_PUBLIC_TIKTOK_HANDLE=@nckllogisticsservices
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
